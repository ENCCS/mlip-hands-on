# Copy to .env outside Git tracking; replace placeholders with your own paths.
# The notebook and MD artifacts must be on storage visible from the GPU node.
MLIP_PROJECT_ROOT=/nobackup/proj/disk/snicXXXX-XX-X/personal/USER/mlip-md
MLIP_MODEL=${MLIP_PROJECT_ROOT}/artifacts/models/mace-mp-0a-small.model
MLIP_MLIAP_MODEL=${MLIP_PROJECT_ROOT}/artifacts/models/mace-mp-0a-small-mliap.pt
MLIP_ALCHEMI_SIF=${MLIP_PROJECT_ROOT}/artifacts/alchemi-aarch64.sif
MLIP_NATIVE_PREFIX=${MLIP_PROJECT_ROOT}/artifacts/lammps-mpi
MLIP_RESULTS_DIR=${MLIP_PROJECT_ROOT}/results
MLIP_JUPYTER_PORT=8888

# Only needed when rebuilding software or running the MPI scaling episode.
MLIP_SIF_OUTPUT=${MLIP_PROJECT_ROOT}/artifacts/alchemi-aarch64-new.sif
MLIP_NATIVE_ARCHIVE=${MLIP_PROJECT_ROOT}/artifacts/native-python.tar.gz
MLIP_LAMMPS_SOURCE_ARCHIVE=${MLIP_PROJECT_ROOT}/artifacts/lammps-source.tar.gz
MLIP_MPI_BUILD_ROOT=${MLIP_PROJECT_ROOT}/artifacts/mpi-builds
MLIP_MPI_ARCHIVE=${MLIP_PROJECT_ROOT}/artifacts/lammps-mpi-runtime.tar.gz
MLIP_MPI_ARCHIVE_SHA256=REPLACE_WITH_VERIFIED_SHA256
