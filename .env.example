# Copy to a private .env. Load it with `set -a; . ./.env; set +a` before
# starting JupyterLab or a command. Paths must be visible on a GPU node.
MLIP_ARTIFACT_ROOT=/path/to/private/artifacts
MLIP_SITE=arrhenius  # change to jupiter there
MLIP_MODEL=${MLIP_ARTIFACT_ROOT}/mace-mp-0a-small.model
MLIP_MLIAP_MODEL=${MLIP_MODEL}-mliap_lammps.pt
MLIP_ALCHEMI_SIF=${MLIP_ARTIFACT_ROOT}/alchemi-aarch64.sif
# For LAMMPS, set the site runtime paths and source its environment script.
# Arrhenius: extracted archive root with python/ and mpi-prefix/.
# JUPITER: LAMMPS installed prefix and its matching MACE Python venv.
MLIP_NATIVE_PREFIX=${MLIP_ARTIFACT_ROOT}/lammps-native
# MLIP_NATIVE_PYTHON=${MLIP_ARTIFACT_ROOT}/env-mace
