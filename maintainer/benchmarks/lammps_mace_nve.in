# Matched silicon NVE start from maintainer/benchmarks/generate_starts.py.
# Required -var values: start, model, warmup, steps.
units           metal
atom_style      atomic/kk
newton          on
boundary        p p p
read_data       ${start}
run_style       verlet/kk
atom_modify     sort 0 0.0

pair_style      mliap/kk unified ${model} 0
pair_coeff      * * Si
timestep        0.0001    # 0.1 fs
fix             integrate all nve/kk

thermo_style    custom step atoms temp pe ke etotal
thermo          100
run             0
run             ${warmup}
run             ${steps}
