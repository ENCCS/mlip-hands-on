+      const downloadUrl = await resolver.getDownloadUrl(resolved);
+      const url = new URL(downloadUrl, window.location.href);
+      if (url.origin !== window.location.origin) continue;
+      if (!decodeURIComponent(url.pathname).includes('/files/')) continue;
